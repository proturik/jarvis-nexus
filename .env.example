# Не вставляйте ключи в чат и не публикуйте этот файл с ключами.
# Скопируйте в .env, если хотите подключить облачный интеллект.
OPENAI_API_KEY=
# Любая доступная вам модель Responses API.
OPENAI_MODEL=

# Необязательно: Home Assistant. Токен остаётся только на этом компьютере.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Допустимые сервисы через запятую, например: light.turn_on,light.turn_off
HOME_ASSISTANT_ALLOWED_SERVICES=
